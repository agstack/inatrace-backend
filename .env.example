# Example environment overrides for the INATrace backend.
#
# Copy this file to .env and keep the local copy out of git. Spring Boot does
# not read .env automatically: export the values before starting the process
# (for example: set -a; . ./.env; set +a) or pass the file to Docker with
# `docker run --env-file .env ...`.
#
# Property names map to environment variables by replacing dots with
# underscores, removing dashes and uppercasing the result:
#   INATrace.database.name        -> INATRACE_DATABASE_NAME
#   INATrace.auth.jwtSigningKey   -> INATRACE_AUTH_JWTSIGNINGKEY

INATRACE_ENV=DEV

# Datasource. Alternatively set SPRING_DATASOURCE_URL directly.
INATRACE_DATABASE_NAME=inatrace
INATRACE_DATABASE_HOSTNAME=localhost
INATRACE_DATABASE_PORT=3306
SPRING_DATASOURCE_USERNAME=inatrace
SPRING_DATASOURCE_PASSWORD=change-me

# Required for every installation. Use a unique random value (at least 32
# bytes) per environment, for example: openssl rand -base64 48
INATRACE_AUTH_JWTSIGNINGKEY=

# Storage and import paths.
INATRACE_FILESTORAGE_ROOT=/data/storage
INATRACE_IMPORT_PATH=import/

# Optional integrations.
INATRACE_EXCHANGERATE_APIKEY=
INATRACE_REQUESTLOG_TOKEN=change-me

# Optional SMTP. Sending is disabled unless INATRACE_MAIL_SENDINGENABLED=true.
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
